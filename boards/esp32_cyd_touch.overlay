#include <zephyr/dt-bindings/display/ili9xxx.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/spi/spi.h>

/ {
	aliases {
		led-red = &ledred;
		led-green = &ledgreen;
		led-blue = &ledblue;
		backlight = &led21;
	};

	leds {
		compatible = "gpio-leds";
		ledred: d4 {
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		};
		ledgreen: d16 {
			gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
		};
		ledblue: d17 {
			gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		};
		led21: d21 {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		};
	};

    chosen {
		zephyr,display = &ili9341;
		zephyr,touch = &xpt2046;
		zephyr,flash = &flash0;
    };

	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&xpt2046>;
		invert-x;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		dc-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		spi-dev = <&spi2>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		ili9341: ili9341@0 {
			compatible = "ilitek,ili9341";
			mipi-max-frequency = <25000000>;
			#spi-max-frequency = <25000000>;
			reg = <0>;
			pixel-format = <0>;
			rotation = <90>;
			width = <320>;
			height = <240>;
		};
	};

	soc {
		spi2 {
			pinctrl-0 = <&spi2_custom_pins>;
			status = "okay";
		};

		pinctrl {
			spi2_custom_pins: spi2_custom_pins {
				group1 {
					pinmux = <SPIM2_MISO_GPIO12>,
						<SPIM2_SCLK_GPIO14> ,
						<SPIM2_CSEL_GPIO15>
						;
				};
				group2 {
					pinmux = <SPIM2_MOSI_GPIO13>;
					output-low;
				};
			};

			spi3_custom_pins: spi3_custom_pins {
				group1 {
					pinmux = <SPIM3_MISO_GPIO39>,
						<SPIM3_SCLK_GPIO25>,
						<SPIM3_CSEL_GPIO33>
						;
				};
				group2 {
					pinmux = <SPIM3_MOSI_GPIO32>;
					output-low;
				};
			};

		};
	};
};

&spim3_default {
	group1 {
		pinmux = <SPIM3_MISO_GPIO39>,
			<SPIM3_SCLK_GPIO25>,
			<SPIM3_CSEL_GPIO33>
			;
	};
	group2 {
		pinmux = <SPIM3_MOSI_GPIO32>;
		output-low;
	};
};

&spi3 {
	compatible = "espressif,esp32-spi";
	status = "okay";
//	pinctrl-0 = <&spi3_custom_pins>;
	xpt2046: xpt2046@0 {
		compatible = "xptek,xpt2046";
		spi-max-frequency = <1000000>;
		reg = <0>;
		int-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		min-x = <0>;
		min-y = <0>;
		max-x = <3800>;
		max-y = <3800>;
		reads = <4>;
	};
};
/*
First, I need to remove the existing partitions node under flash0,
then I define a new partitions node with my custom partition layout.

Check ~/zephyr/dts/vendor/espressif/ for reference partition tables according to the device.

I dont need to redefine boot and sys partitions but I do it for clarity.

*/
&flash0 { /delete-node/ partitions; };
&flash0 {

	partitions {

		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@1000 {
			label = "mcuboot";
			reg = <0x1000 DT_SIZE_K(60)>;
		};

		sys_partition: partition@10000 {
			label = "sys";
			reg = <0x10000 DT_SIZE_K(64)>;
		};

		/* Slot zero 1778 KB */
		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x20000 DT_SIZE_K(1778)>;
		};

		/* Slot zero 1778 KB */
		slot1_partition: partition@1e0000 {
			label = "image-1";
			reg = <0x1E0000 DT_SIZE_K(1778)>;
		};

		/* Scratch partition 124 KB */
		scratch_partition: partition@3e0000 {
			label = "image-scratch";
			reg = <0x3E0000 DT_SIZE_K(124)>;
		};

		/* Coredump partition 4 KB */
		coredump_partition: partition@3ff000 {
			label = "coredump";
			reg = <0x3FF000 DT_SIZE_K(4)>;
		};

		/* Storage partition 192 KB */
		storage_partition: partition@3b0000 {
			label = "storage";
			reg = <0x3B0000 DT_SIZE_K(192)>;
		};
	};
};

